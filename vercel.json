{
  "routes": [
    {
      "src": "/prototipo",
      "status": 308,
      "headers": {
        "Location": "/prototipo/"
      }
    },
    {
      "src": "/prototipo/",
      "dest": "/prototipo/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
